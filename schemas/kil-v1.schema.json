{
  "$defs": {
    "BoardSide": {
      "enum": [
        "front",
        "back"
      ],
      "type": "string"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "footprint": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "footprint"
      ],
      "type": "object"
    },
    "Hole": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "diameter": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "at",
        "diameter"
      ],
      "type": "object"
    },
    "ModuleImport": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "net_map": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "path": {
          "type": "string"
        },
        "pcb": {
          "$ref": "#/$defs/Transform",
          "default": {
            "at": [
              0.0,
              0.0
            ],
            "rotation": 0.0
          }
        },
        "schematic": {
          "$ref": "#/$defs/Transform",
          "default": {
            "at": [
              0.0,
              0.0
            ],
            "rotation": 0.0
          }
        }
      },
      "required": [
        "id",
        "path"
      ],
      "type": "object"
    },
    "Pcb": {
      "additionalProperties": false,
      "properties": {
        "holes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Hole"
          },
          "type": "array"
        },
        "outline": {
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "placement": {
          "additionalProperties": {
            "$ref": "#/$defs/PcbPlacement"
          },
          "type": "object"
        },
        "routes": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Route"
            },
            "type": "array"
          },
          "default": {},
          "type": "object"
        },
        "routing": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoutingPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "silk": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SilkText"
          },
          "type": "array"
        },
        "vias": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Via"
          },
          "type": "array"
        },
        "zones": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Zone"
          },
          "type": "array"
        }
      },
      "required": [
        "outline",
        "placement"
      ],
      "type": "object"
    },
    "PcbPlacement": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "locked": {
          "default": false,
          "type": "boolean"
        },
        "rotation": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "side": {
          "$ref": "#/$defs/BoardSide",
          "default": "front"
        }
      },
      "required": [
        "at"
      ],
      "type": "object"
    },
    "ProjectMeta": {
      "additionalProperties": false,
      "properties": {
        "kicad": {
          "default": 10,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "layer": {
          "default": "F.Cu",
          "type": "string"
        },
        "locked": {
          "default": false,
          "type": "boolean"
        },
        "path": {
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "width": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "RoutingEngine": {
      "enum": [
        "kicad-routing-tools"
      ],
      "type": "string"
    },
    "RoutingPolicy": {
      "additionalProperties": false,
      "properties": {
        "cache": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "$ref": "#/$defs/RoutingEngine"
        },
        "extra_args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "nets": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "engine"
      ],
      "type": "object"
    },
    "Rules": {
      "additionalProperties": false,
      "properties": {
        "clearance": {
          "default": 0.2,
          "format": "double",
          "type": "number"
        },
        "track_width": {
          "default": 0.25,
          "format": "double",
          "type": "number"
        },
        "via_drill": {
          "default": 0.4,
          "format": "double",
          "type": "number"
        },
        "via_size": {
          "default": 0.8,
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Schematic": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SchematicLabel"
          },
          "type": "array"
        },
        "no_connect": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "placement": {
          "additionalProperties": {
            "$ref": "#/$defs/SchematicPlacement"
          },
          "default": {},
          "type": "object"
        },
        "wires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SchematicWire"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SchematicLabel": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "net": {
          "type": "string"
        },
        "rotation": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "net",
        "at"
      ],
      "type": "object"
    },
    "SchematicPlacement": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "rotation": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "at"
      ],
      "type": "object"
    },
    "SchematicWire": {
      "additionalProperties": false,
      "properties": {
        "net": {
          "type": "string"
        },
        "path": {
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "net",
        "path"
      ],
      "type": "object"
    },
    "SilkText": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "layer": {
          "default": "F.SilkS",
          "type": "string"
        },
        "rotation": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "at"
      ],
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "default": [
            0.0,
            0.0
          ],
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "rotation": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Units": {
      "enum": [
        "mm"
      ],
      "type": "string"
    },
    "Via": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "drill": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "locked": {
          "default": false,
          "type": "boolean"
        },
        "net": {
          "type": "string"
        },
        "size": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "net",
        "at"
      ],
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "properties": {
        "clearance": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "layer": {
          "default": "F.Cu",
          "type": "string"
        },
        "net": {
          "type": "string"
        },
        "outline": {
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "net",
        "outline"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/mkroplewski/kil/master/schemas/kil-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "JSON Schema URI used by editors for completion and validation.",
      "type": "string",
      "writeOnly": true
    },
    "components": {
      "additionalProperties": {
        "$ref": "#/$defs/Component"
      },
      "type": "object"
    },
    "format_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "imports": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ModuleImport"
      },
      "type": "array"
    },
    "nets": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "pcb": {
      "$ref": "#/$defs/Pcb"
    },
    "project": {
      "$ref": "#/$defs/ProjectMeta"
    },
    "rules": {
      "$ref": "#/$defs/Rules",
      "default": {
        "clearance": 0.2,
        "track_width": 0.25,
        "via_drill": 0.4,
        "via_size": 0.8
      }
    },
    "schematic": {
      "$ref": "#/$defs/Schematic",
      "default": {
        "labels": [],
        "no_connect": [],
        "placement": {},
        "wires": []
      }
    },
    "units": {
      "$ref": "#/$defs/Units",
      "default": "mm"
    }
  },
  "required": [
    "format_version",
    "project",
    "components",
    "nets",
    "pcb"
  ],
  "title": "KilProject",
  "type": "object"
}
